+    def trigger_workflow(
+        self,
+        repo_name: str,
+        workflow_id: str,
+        ref: str,
+        inputs: Optional[Dict[str, str]] = None,
+    ) -> bool:
+        """Trigger a GitHub Actions workflow."""
+        try:
+            repo = self.client.get_repo(repo_name)
+            workflow = repo.get_workflow(workflow_id)
+            return workflow.create_dispatch(ref, inputs or {})
+        except GithubException as e:
+            raise Exception(f"Failed to trigger workflow: {e}")
+
+    def poll_workflow_run(
+        self,
+        repo_name: str,
+        workflow_id: str,
+        branch: str,
+        trigger_time: str,
+        timeout_seconds: int = 300,
+    ) -> Optional[Dict]:
+        """Poll for workflow completion.
+        trigger_time should be a datetime object or isoformat string.
+        Returns the run object if completed successfully, else None.
+        """
+        import time, datetime
+        try:
+            repo = self.client.get_repo(repo_name)
+            workflow = repo.get_workflow(workflow_id)
+            if isinstance(trigger_time, str):
+                trigger_time = datetime.datetime.fromisoformat(trigger_time.replace('Z', '+00:00'))
+            
+            start_poll = time.time()
+            while time.time() - start_poll < timeout_seconds:
+                runs = workflow.get_runs(branch=branch)
+                for run in runs:
+                    if run.created_at >= trigger_time:
+                        if run.status == "completed":
+                            return run.raw_data
+                time.sleep(10)
+            return None
+        except GithubException as e:
+            raise Exception(f"Failed to poll workflow run: {e}")
+
+    def download_artifact_json(
+        self,
+        repo_name: str,
+        run_id: int,
+        artifact_name: str,
+    ) -> Optional[Dict]:
+        """Download and parse a JSON artifact from a workflow run."""
+        import zipfile, io, json, requests
+        try:
+            repo = self.client.get_repo(repo_name)
+            run = repo.get_workflow_run(run_id)
+            for artifact in run.get_artifacts():
+                if artifact.name == artifact_name:
+                    headers = {"Authorization": f"token {self.token}"}
+                    response = requests.get(artifact.archive_download_url, headers=headers, allow_redirects=True)
+                    response.raise_for_status()
+                    
+                    with zipfile.ZipFile(io.BytesIO(response.content)) as z:
+                        for filename in z.namelist():
+                            if filename.endswith('.json'):
+                                with z.open(filename) as f:
+                                    return json.load(f)
+            return None
+        except Exception as e:
+            raise Exception(f"Failed to download artifact {artifact_name}: {e}")
