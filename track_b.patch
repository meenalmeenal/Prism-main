+                tc_id = entry.get("test_case_id")
+                sync_results.append({
+                    "test_case_id": tc_id,
+                    "execution_id": test_case_id_to_execution_id.get(tc_id),
+                    "status": self._to_zephyr_status(entry.get("status", "")),
+                    "synced": True,
+                    "dry_run": True,
+                })
+            return sync_results
+
+        await self.connect()
+        try:
+            for entry in per_test_results or []:
+                tc_id = entry.get("test_case_id")
+                execution_id = test_case_id_to_execution_id.get(tc_id)
+                if not tc_id or not execution_id:
+                    logger.warning(
